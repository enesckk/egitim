# ==============================================================================
# Egitim Platformu — Production Environment Variables Template
#
# Copy this file to .env.production and populate with secure production secrets:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# NEVER commit .env.production or real credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & HTTPS Gateway (Caddy)
# ------------------------------------------------------------------------------
# Domain name(s) served by Caddy.
# - Use "localhost, 127.0.0.1" for local/internal TLS verification (self-signed).
# - Set to your public domain (e.g. "portal.bilimakademi.com") for automatic Let's Encrypt HTTPS.
SITE_ADDRESS="localhost, 127.0.0.1"

# Exact external origin allowed for CORS and CSRF validation (must include scheme, no trailing slash).
# Example for public domain: https://portal.bilimakademi.com
CORS_ALLOWED_ORIGIN="https://localhost"

# Host ports bound by the Caddy gateway (defaults: 80 and 443)
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# Frontend API base URL at build time (leave empty for same-origin /api routing via Caddy)
VITE_API_BASE_URL=""

# ------------------------------------------------------------------------------
# 2. Database (MSSQL 2022 — Internal Network Only)
# ------------------------------------------------------------------------------
# Strong SA password required by SQL Server (min 8 chars, uppercase, lowercase, digits, symbols)
MSSQL_SA_PASSWORD="<REPLACE_WITH_STRONG_MSSQL_SA_PASSWORD>"
MSSQL_DATABASE="EgitimPlatform"
MSSQL_PID="Developer"

# ------------------------------------------------------------------------------
# 3. JWT Authentication
# ------------------------------------------------------------------------------
# Cryptographically random signing key (MUST be at least 32 characters in Production)
# Generate with: openssl rand -base64 48
JWT_SIGNING_KEY="<REPLACE_WITH_MIN_32_CHAR_CRYPTOGRAPHIC_SIGNING_KEY>"
JWT_ISSUER="EgitimPlatform"
JWT_AUDIENCE="EgitimPlatform"
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------------------------
# 4. One-Time Platform Bootstrap (Optional — Used only by 'migrate' service)
# ------------------------------------------------------------------------------
# Set BOOTSTRAP_ENABLED=true only on initial deployment to create the initial SuperAdmin,
# then set back to false.
BOOTSTRAP_ENABLED=false
BOOTSTRAP_SUPERADMIN_EMAIL=""
BOOTSTRAP_SUPERADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# 5. Rate Limiting (Requests per minute per client IP)
# ------------------------------------------------------------------------------
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REFRESH=30
RATE_LIMIT_UPLOAD=20

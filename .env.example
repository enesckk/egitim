# ==============================================================================
# Eğitim Platformu — Staging & Production Environment Configuration Example
# Copy to .env or export into your environment manager (Docker, Systemd, K8s, etc.)
# DO NOT COMMIT REAL PASSWORDS, TOKENS, OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# Core ASP.NET Core Settings
ASPNETCORE_ENVIRONMENT=Staging
ASPNETCORE_URLS=https://127.0.0.1:5055;http://127.0.0.1:5056

# Database Connection (Persistent MSSQL Instance)
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=EgitimPlatform_Staging;User Id=sa;Password=<STRONG_DB_PASSWORD>;TrustServerCertificate=True;"

# JWT Authentication (Key must be at least 32 characters in Staging/Production)
JwtSettings__SigningKey=<SECURE_RANDOM_SIGNING_KEY_MIN_32_CHARS>
JwtSettings__Issuer=EgitimPlatform
JwtSettings__Audience=EgitimPlatformApp
JwtSettings__AccessTokenMinutes=15
JwtSettings__RefreshTokenDays=7

# CORS & CSRF Allowed Origins (Exact origins, NO wildcards allowed with credentials)
CorsSettings__AllowedOrigins__0=https://staging.egitim.com
CorsSettings__AllowedOrigins__1=http://localhost:3005

# Reverse Proxy / Ingress Forwarding Support
ReverseProxy__Enabled=true
ReverseProxy__ForwardLimit=1
# ReverseProxy__KnownProxies__0=10.0.0.1

# Demo Showcase Seeder (STAGING ONLY — Keep false in production)
DemoSeed__Enabled=true
DemoSeed__AdminEmail=admin.demo@egitim.com
DemoSeed__AdminPassword=<SECURE_DEMO_ADMIN_PASSWORD>
DemoSeed__TeacherEmail=teacher.demo@egitim.com
DemoSeed__TeacherPassword=<SECURE_DEMO_TEACHER_PASSWORD>
DemoSeed__CoachEmail=coach.demo@egitim.com
DemoSeed__CoachPassword=<SECURE_DEMO_COACH_PASSWORD>
DemoSeed__StudentEmail=student.demo@egitim.com
DemoSeed__StudentPassword=<SECURE_DEMO_STUDENT_PASSWORD>
DemoSeed__ParentEmail=parent.demo@egitim.com
DemoSeed__ParentPassword=<SECURE_DEMO_PARENT_PASSWORD>

# AI Provider Settings (Optional fallback supported)
# Ai__Provider=OpenAI
# Ai__ApiKey=<SECURE_AI_API_KEY>

# Frontend Configuration (Used at build time)
VITE_API_BASE_URL=https://staging-api.egitim.com
